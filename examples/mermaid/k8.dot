graph K8 {
  // Circular layout using Circo engine (no center node)
  layout=circo;
  overlap=false;
  ranksep=7.0;

  // Node style: smaller circles with labels
  node [shape=circle, width=0.3, fixedsize=true, fontsize=12];

  // Edge settings for longer edges
  edge [len=7.0];

  // Vertices
  A; B; C; D; E; F; G; H;

  // Complete graph edges (undirected)
  A -- B; A -- C; A -- D; A -- E; A -- F; A -- G; A -- H;
  B -- C; B -- D; B -- E; B -- F; B -- G; B -- H;
  C -- D; C -- E; C -- F; C -- G; C -- H;
  D -- E; D -- F; D -- G; D -- H;
  E -- F; E -- G; E -- H;
  F -- G; F -- H;
  G -- H;
}
